  <rdf:Description rdf:about="http://www.openkg.cn/ontology/harry-potter-core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="zh">哈利·波特核心人物关系图谱（课堂演示版）</rdfs:label>
    <dcterms:title xml:lang="en">Harry Potter Core Characters - classroom edition</dcterms:title>
    <dcterms:description xml:lang="zh">围绕哈利·波特、赫敏·格兰杰、罗恩·韦斯莱、德拉科·马尔福四人的简化知识图谱，用于课堂汇报演示。大部分三元组取自 OpenKG 哈利·波特数据集，其中“朋友”“对手”关系及个别家庭关系为演示补充。</dcterms:description>
    <dcterms:source rdf:resource="http://data.openkg.cn/dataset/openkg-harry-potter"/>
    <owl:versionInfo>1.0 (classroom)</owl:versionInfo>
    <rdfs:comment xml:lang="en">Derived from harrypotter.rdf / harrypotterproperty.json of the OpenKG dataset. See README for the list of supplementary assertions.</rdfs:comment>
  </rdf:Description>
